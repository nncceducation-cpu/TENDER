{
  "name": "tender",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint",
    "typecheck": "tsc -b --noEmit",
    "fetch:models": "node scripts/fetch-models.mjs",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run build",
    "build:standalone": "vite build --config vite.standalone.config.ts"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.0.1",
    "lucide-react": "^1.31.0",
    "onnxruntime-web": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.10"
  },
  "description": "On-device clinical decision support for neonatal pain assessment and opioid weaning.",
  "license": "UNLICENSED"
}
